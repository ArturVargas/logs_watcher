# Copy to .env, chmod 600. Never commit. Empty value = that provider is off.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://logs_watcher:<POSTGRES_PASSWORD>@db:5432/logs_watcher
LOGS_WATCHER_DRY_RUN=true
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/logs-watcher/github-app.pem
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
SENTRY_AUTH_TOKEN=
SENTRY_WEBHOOK_SECRET_METRO=
SENTRY_WEBHOOK_SECRET_COPBY=
TYPESAFE_API_KEY=
POSTHOG_API_KEY=
RAILWAY_LOG_WEBHOOK_SECRET=
VERCEL_LOG_WEBHOOK_SECRET=
CLOUDFLARE_LOG_WEBHOOK_SECRET=
ALERT_WEBHOOK_URL=
